# Copy this file to .env and fill in your values.

# --- Database -------------------------------------------------------------
# Leave unset to use a local SQLite file (zero setup). For Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/bookleaf
# DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- AI / LLM -------------------------------------------------------------
# Your Anthropic API key. If left blank, the app still runs and the AI
# features degrade gracefully (rule-based triage + manual drafting).
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-haiku-20241022
AI_ENABLED=true

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
