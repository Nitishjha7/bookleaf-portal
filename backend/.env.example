# copy to .env

# leave empty for sqlite. postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/bookleaf

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# free key from https://aistudio.google.com/apikey
# if empty the app still works, triage just uses the keyword rules
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
# comma separated, used if the main model is out of quota
AI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
AI_ENABLED=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
